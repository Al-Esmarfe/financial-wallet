{
  "name": "financial-wallet",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:bun": "bun src/main.ts",
    "start:prod": "bun dist/main.js",
    "lint": "oxlint src test scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "mikro-orm migration:up",
    "db:migrate:down": "mikro-orm migration:down",
    "db:migrate:create": "mikro-orm migration:create",
    "db:migrate:test": "POSTGRES_DB=financial_wallet_test mikro-orm migration:up",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:watch": "bun test --watch test/unit",
    "test:cov": "bun test --coverage test/unit",
    "test:integration": "POSTGRES_DB=financial_wallet_test bun test test/integration/database",
    "test:integration:messaging": "POSTGRES_DB=financial_wallet_test bun test test/integration/messaging",
    "test:multi-instance": "POSTGRES_DB=financial_wallet_test bun test test/integration/multi-instance",
    "test:e2e": "POSTGRES_DB=financial_wallet_test bun test test/e2e",
    "test:all": "POSTGRES_DB=financial_wallet_test bun test",
    "test:load": "bun run scripts/load-test.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^7",
    "@mikro-orm/decorators": "^7",
    "@mikro-orm/migrations": "^7",
    "@mikro-orm/nestjs": "^7",
    "@mikro-orm/postgresql": "^7",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@aws-sdk/client-sqs": "^3.1000.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
