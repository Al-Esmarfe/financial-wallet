# APPLICATION
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# POSTGRESQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=wallet_password
POSTGRES_DB=financial_wallet

# AWS / LOCALSTACK
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
# Exigido pelas versões recentes da imagem do LocalStack (https://app.localstack.cloud)
LOCALSTACK_AUTH_TOKEN=

# SQS — entrada: provedores publicam WagerTransactionRequested aqui
SQS_WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# SQS — saída: o outbox publica os eventos de integração aqui
SQS_WAGER_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_WAGER_EVENTS_DLQ_URL=http://localhost:4566/000000000000/wager-events-dlq.fifo

# INBOX CONSUMER
INBOX_POLL_INTERVAL_MS=1000
INBOX_WAIT_TIME_SECONDS=5
INBOX_VISIBILITY_TIMEOUT_SECONDS=60
INBOX_MAX_RECEIVE_COUNT=5

# OUTBOX PUBLISHER
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_PUBLISH_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_CAP_MS=60000

# REFERENCE RETRY WORKER (REFUND/ROLLBACK que chegam antes da referência)
REFERENCE_RETRY_INTERVAL_MS=5000
REFERENCE_RETRY_BATCH_SIZE=50
